NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=app
DB_USERNAME=postgres
DB_PASSWORD=password

# openssl rand -base64 32 로 생성 (16자 이상 필수)
JWT_SECRET=
JWT_EXPIRES_IN=1d

# CORS 허용 오리진 (콤마 구분). 개발에선 비우면 전체 허용, production 에선 필수(미설정 시 부팅 실패).
CORS_ORIGIN=

# 분당 요청 제한 (rate limiting)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
